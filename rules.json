    ]
  },
  "boundaries": {
    "_about": "Decides where a formula starts, where it ends, and what terminates it.",
    "math_chars": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\\^_{}()[]|<>+-*/=.,;:!'\"~ \t",
    "stop_chars": {
      "cjk_punctuation": "，。、；：？！“”‘’（）《》【】…—·「」『』",
      "other": [
        "CJK ideographs",
        "$",
        "line break"
      ]
    },
    "bracket_allowance": {
      "_about": "When paired CJK brackets enclose a whole formula, the brackets are wrapped with it.",
      "pairs": [
        [
          "（",
          "）"
        ],
        [
          "《",
          "》"
        ],
        [
          "【",
          "】"
        ],
        [
          "「",
          "」"
        ],
        [
          "『",
          "』"
        ]
      ]
    },
    "trim_trailing": ".,;:!?'\"*",
    "_across_space_rule": "After a space the next token must be math; relax to single letters/digits only when the fragment already contains an operator or command.",
    "_space_continuations": [
      "backslash command",
      "sub/superscript ^ _",
      "closing bracket )]}",
      "operator =+-*/<>",
      "letter followed by ( ^ or _",
      "digits followed by an operator or end"
    ],
    "cjk_punctuation": "，。、；：？！“”‘’（）《》【】…—·「」『』",
    "other": [
      "CJK ideographs",
      "$",
      "line break"
    ],
    "_math_chars_note": "Letters, digits, LaTeX punctuation and whitespace are allowed inside a fragment.",
    "_trim_trailing_note": "Sentence punctuation must not stay inside a formula."
  },
  "protected_regions": {
    "_about": "Regions where no $ is ever inserted.",
    "regions": [
      "YAML front matter (--- ... --- at the top of the file)",
      "fenced code blocks (``` or ~~~)",
      "inline code (`...`)",
      "Markdown links and images ([..](..) / ![..](..))",
      "wiki links ([[..]])",
      "bare URLs (http(s)://...)",
      "HTML tags (<...>)"
    ]
  },
  "known_limits": {
    "_about": "Deliberately not handled; these are decisions, not bugs.",
    "bare_ascii_equals": "A lone = is not an anchor (it would hit 'width = 0'), but 'a = b' is caught by the bare_comparison rule when both operands exist."
  }
