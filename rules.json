  "structural": {
    "_about": "Sub/superscripts, function notation and relations describe formula structure.",
    "sub_superscript": {
      "trigger": "[A-Za-z0-9)\\]}]\\s*[\\^_]\\s*(\\{[^{}]*\\}|\\\\[a-zA-Z]+|[A-Za-z0-9])",
      "exception": "A lone L_L pattern with no other signal does not trigger, so emoticons like T_T are not mistaken for math."
    },
    "function_notation": {
      "trigger": "(?<![\\\\A-Za-z])[A-Za-z](?:_\\{?[A-Za-z0-9]+\\}?)?\\(",
      "note": "A single letter (optionally subscripted) followed by an open paren. Precisely excludes prose such as series(x), Log(x) or 'the value (x) is'."
    },
    "relations": {
      "continue": "le|leq|ge|geq|ne|neq|implies|iff|to|rightarrow|leftarrow|in|notin|subset|subseteq|supset|supseteq|approx|equiv|sim|simeq|cong|propto|cdot|times|pm|mp|ll|gg",
      "ascii": [
        "<=",
        ">=",
        "!=",
        "=",
        "<",
        ">"
      ],
      "note": "Used to confirm a complete relation follows function notation, e.g. r(A) = n."
    },
    "bare_comparison": {
      "_about": "Comparisons written bare in prose, e.g. u < v or r = |x-a|.",
      "trigger": "[A-Za-z0-9)\\]}|]\\s*(?:<=|>=|!=|<|>|≤|≥|≠|=)\\s*-?[A-Za-z0-9(|\\\\{]",
      "note": "Both operands must be present. Bare = additionally requires letter/digit/pipe on both sides so that 'width = 0' is not touched."
    },
    "lone_variable": {
      "_about": "A math symbol standing alone in prose, e.g. the X in 'the domain of X'.",
      "trigger": "(?<![\\\\A-Za-z0-9])[A-Za-z](?![A-Za-z0-9])",
      "note": "Only conventional math letters, so ordinary words are not treated as variables.",
      "letters": [
        "X",
        "Y",
        "Z",
        "x",
        "y",
        "z",
        "f",
        "g",
        "h",
        "p",
        "q",
        "r",
        "u",
        "v",
        "w",
        "A",
